# PSM TouchCTF — Production Environment
# Copy to .env.prod and fill in real values before deploying.
# DO NOT commit this file with real secrets.

# ── Database ──────────────────────────────────────────────
# Password for PostgreSQL (must match secrets/db_password.txt)
DB_PASSWORD=CHANGE_ME

# ── Application ───────────────────────────────────────────
# Secret key for session signing (must match secrets/app_secret.txt)
APP_SECRET=CHANGE_ME

# Environment: production | development
APP_ENV=production

# Number of uvicorn workers (CPU cores - 1 is a good default)
API_WORKERS=2

# ── Ports ─────────────────────────────────────────────────
# HTTP port exposed to the host (80 for production)
HTTP_PORT=80

# ── Optional ──────────────────────────────────────────────
# Public base URL (used for CORS and redirects)
# PUBLIC_BASE_URL=https://ctf.example.com
