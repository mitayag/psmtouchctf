# Example environment configuration for local development
# Copy to .env and customize; do not commit real secrets.

APP_ENV=development
DATABASE_BACKEND=sqlite
SQLITE_PATH=/tmp/touchctf.db
# Required when DATABASE_BACKEND=postgresql (must match secrets/db_password.txt)
DB_PASSWORD=touchctf
APP_SECRET=dev-secret-change-me
ALLOWED_HOSTS=*
COOKIE_SECURE=false
MEDIA_DIR=/app/media
LOG_LEVEL=INFO
API_WORKERS=1
